{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug-sanitizers",
      "displayName": "Debug with ASan and UBSan (GCC/Clang)",
      "binaryDir": "${sourceDir}/build/debug-sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SHODHAN_SANITIZE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug-sanitizers", "configurePreset": "debug-sanitizers" }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug-sanitizers",
      "configurePreset": "debug-sanitizers",
      "output": { "outputOnFailure": true },
      "environment": {
        "SHODHAN_MIP_SEED_COUNT": "150",
        "SHODHAN_CUT_SEEDS": "12",
        "SHODHAN_CUT_PIPE_SEEDS": "20"
      }
    }
  ]
}
